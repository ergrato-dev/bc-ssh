#   $pub, $dir/$ca.pub o $dir/serial; firma con el agente (-U) si la llave
#   privada de la CA no está en $dir (3-proyecto/README.md, paso 3).
# TODO 4: firma con el siguiente número de serie y, solo si funciona,
#   actualiza serial, copia el certificado a emitidos/ y añade su línea a
#   emitidos.log (paso 3).
echo "ca-sign: sin terminar (TODOs 3 y 4)" >&2
exit 1
