#!/usr/bin/env bash
#
# tunnel — abre, comprueba o cierra un túnel persistente definido en conf.d/.
#
# Uso: tunnel up NOMBRE [OPCIONES DE SSH...] | tunnel status NOMBRE | tunnel down NOMBRE
#
#   up      arranca `autossh` en segundo plano para el host NOMBRE del kit
#           (por ejemplo tun-pg) y espera a que su LocalForward escuche.
#           Si ya está activo, no arranca otro. Las opciones extra van a ssh
#           (por ejemplo -o LogLevel=DEBUG).
#   status  dice si el túnel está activo: proceso vivo y puerto escuchando.
#   down    cierra el túnel (autossh y su ssh).
#
# autossh vuelve a lanzar ssh cada vez que muere: el túnel sobrevive a un
# corte de red o a un reinicio del servidor. ServerAliveInterval (en el host
# del túnel) es lo que detecta que la conexión murió sin avisar.
#
# TUNNEL_DIR guarda los PID (~/.ssh/tun); TUNNEL_TIMEOUT, los segundos que
# `up` espera al puerto (10).
# Códigos de salida: 0 bien (status: activo), 1 no se abrió o no está activo,
# 2 uso incorrecto.

set -euo pipefail

uso() {
  echo "uso: tunnel up NOMBRE [OPCIONES DE SSH...] | tunnel status NOMBRE | tunnel down NOMBRE" >&2
  exit 2
}
# TODO 4: sale con uso() si faltan argumentos, si la orden no es up, status
#   o down, si status o down reciben algo más que NOMBRE, o si NOMBRE tiene
#   caracteres raros. TUNNEL_TIMEOUT (10 por defecto) debe ser un entero
#   mayor que 0; si no, sale con 2 (paso 5).
orden=${1:-} nombre=${2:-}
shift 2 || true
espera="${TUNNEL_TIMEOUT:-10}"

kit="$(cd "$(dirname "$0")/.." && pwd)"
dir="${TUNNEL_DIR:-$HOME/.ssh/tun}"
pidfile="$dir/$nombre.pid"

# El puerto local sale de la propia configuración: ssh -G escribe
#   localforward [127.0.0.1]:15432 [db]:5432
# Nos quedamos con el primero: 127.0.0.1 y 15432.
fwd=$(ssh -G -F "$kit/config" "$nombre" | awk '$1 == "localforward" { print $2; exit }')
if [[ -z "$fwd" ]]; then
  echo "tunnel: $nombre no tiene LocalForward en el kit" >&2
  exit 1
fi
puerto=${fwd##*:}
ip=${fwd%:*}
ip=${ip//[\[\]]/}
# Un LocalForward sin dirección (solo el puerto) escucha en localhost.
[[ "$ip" == "$puerto" || "$ip" == '*' || -z "$ip" ]] && ip=127.0.0.1

# autossh borra su pidfile al salir: puede desaparecer entre comprobarlo y
# leerlo, de ahí el 2>/dev/null de cat.
vivo() {
  local pid
  pid=$(cat "$pidfile" 2>/dev/null) && kill -0 "$pid" 2>/dev/null
}
escucha() { nc -z -w 1 "$ip" "$puerto" 2>/dev/null; }

parar() {
  # TODO 7: si autossh está vivo, mándale TERM (kill) y espera hasta 5 s a
  #   que salga; después borra el pidfile (paso 8).
  :
}

case "$orden" in
  status)
    # TODO 5: sale con 0 y dice "activo" si el proceso vive y el puerto
    #   escucha; si no, sale con 1 (paso 8).
    exit 1
    ;;
  down)
    parar
    echo "tunnel: $nombre cerrado"
    exit 0
    ;;
esac

# TODO 8: si el túnel ya está vivo, no arranques otro (sale con 0); si el
#   puerto ya escucha (otro programa), sale con 1 (paso 7).

# TODO 6: crea TUNNEL_DIR (700), arranca autossh -M 0 -f con
#   AUTOSSH_PIDFILE y AUTOSSH_GATETIME=0, con -F del kit, las opciones
#   extra ("$@") y el nombre. Espera hasta TUNNEL_TIMEOUT segundos a que el
#   puerto escuche: sale con 0 si escucha; si no, para autossh y sale con 1
#   (paso 6).
echo "tunnel: sin terminar" >&2
exit 1
