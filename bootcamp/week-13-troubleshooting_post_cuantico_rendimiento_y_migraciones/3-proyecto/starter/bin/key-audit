#!/usr/bin/env bash
#
# key-audit — dice qué llaves de un authorized_keys (o de cualquier lista de
# llaves públicas) hay que migrar.
#
# Uso: key-audit ARCHIVO...      (- lee la entrada estándar)
#
# Códigos de salida: 0 todas bien, 1 alguna para migrar, 2 uso incorrecto o
# archivo ilegible.
set -euo pipefail

# TODO 5: por cada archivo, ssh-keygen -lf y una línea por llave:
#   "ok      TIPO BITS  COMENTARIO" o "migrar  TIPO BITS  COMENTARIO  MOTIVO"
#   para DSA, RSA de menos de 3072 bits y ECDSA.
echo "key-audit: sin terminar (TODO 5)" >&2
exit 1
