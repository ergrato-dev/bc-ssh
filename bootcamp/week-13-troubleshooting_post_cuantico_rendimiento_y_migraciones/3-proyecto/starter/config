# ssh-infra-kit — configuración de cliente SSH
#
# Qué: valores por defecto para todos los hosts; los hosts concretos y los
#   perfiles viven en conf.d/, un archivo por tema.
# Para qué: añadir o quitar un grupo de hosts sin tocar este archivo.
# Impacto: todo `ssh`, `scp` y `sftp` que lea este archivo usa estos valores.
#
# ssh usa el PRIMER valor que encuentra para cada opción: el Include va
# arriba, para que lo concreto de conf.d/ gane, y `Host *` al final.
# Pruébalo sin conectar: ssh -G -F config lab-server

# Qué: lee conf.d/*.conf en orden alfabético (00-, 10-, ...).
# Para qué: separar perfiles (00-perfiles.conf) y hosts (10-lab.conf).
# Impacto: una ruta relativa en Include se busca desde ~/.ssh, no desde la
#   carpeta de este archivo; por eso bin/kit-link crea ~/.ssh/kit. Si el
#   enlace no existe, ssh ignora el Include sin avisar y los alias fallan.
Include kit/conf.d/*.conf

Host *
    # Sin esto, un host que no responde deja la terminal colgada ~2 min
    # (el timeout de TCP del sistema). Con 5 s, el fallo llega enseguida.
    ConnectTimeout 5
    # Qué: ssh nunca acepta por su cuenta una host key desconocida o cambiada.
    # Para qué: que las llaves entren en known_hosts solo verificadas, con
    #   bin/kh-add, y no con un "yes" escrito de memoria.
    # Impacto: el primer ssh a un host nuevo falla con "No ED25519 host key
    #   is known" hasta que lo añades; un cambio de llave corta siempre.
    StrictHostKeyChecking yes
    # Nombres de host cifrados en known_hosts: quien copie el archivo no
    # obtiene la lista de servidores a los que entras.
    HashKnownHosts yes
    # Qué: ssh ofrece solo las llaves de IdentityFile (y no todas las de
    #   ~/.ssh ni todas las del agente).
    # Para qué: no gastar intentos del servidor en llaves que no son suyas
    #   (sshd corta tras 6: "Too many authentication failures") ni mostrar
    #   a cada servidor todas tus llaves públicas.
    # Impacto: un host sin IdentityFile propio solo prueba las llaves por
    #   defecto (~/.ssh/id_ed25519, id_rsa...).
    IdentitiesOnly yes
    # Qué: la primera vez que ssh abre una llave con frase de paso, la deja
    #   en el agente durante 1 h.
    # Para qué: escribir la frase una vez por sesión de trabajo, no en cada
    #   conexión, y sin cargar la llave a mano con ssh-add.
    # Impacto: sin agente (SSH_AUTH_SOCK vacío) no hace nada; pasada 1 h,
    #   la siguiente conexión vuelve a pedir la frase.
    AddKeysToAgent 1h
    # Qué: no reenviar nunca el agente a los servidores.
    # Para qué: mientras dura una conexión con el agente reenviado, root en
    #   ese servidor puede usar tu agente para entrar donde entras tú.
    # Impacto: para saltar de un host a otro, ssh-add -h (semana 04) o
    #   ProxyJump (semana 09). Un bloque Host concreto puede activarlo antes.
    ForwardAgent no
    # Qué: la primera conexión a un host queda abierta como "master" y las
    #   siguientes viajan dentro de ella por un socket en ~/.ssh/cm/.
    # Para qué: sin TCP, intercambio de llaves ni autenticación, cada ssh,
    #   scp o git siguiente tarda milisegundos y no vuelve a pedir la frase.
    # Impacto: quien pueda abrir el socket entra sin autenticarse (por eso
    #   ~/.ssh/cm es 700); revocar la llave no corta un master vivo
    #   (bin/mux stop); %C, un hash de 40 caracteres, evita rutas demasiado
    #   largas para un socket. `ssh -P sinmux` lo desactiva para un comando.
    ControlMaster auto
    ControlPath ~/.ssh/cm/%C
    # El master sigue 10 min tras cerrar la última sesión.
    ControlPersist 10m
    # TODO 7: UpdateHostKeys yes, para rotar host keys sin avisos.
